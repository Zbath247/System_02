# ==========================================
# University Attendance Management System
# Root Environment Variables Configuration
# ==========================================

# Port Configuration
PORT=5000
FRONTEND_PORT=5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/university_attendance?schema=public"

# Public Attendance Landing URL (encoded in Shared System QR Code)
PUBLIC_ATTENDANCE_URL="http://localhost:5173/scan"

# Session & Security Settings
SESSION_SECRET="super-secret-cryptographic-key-change-in-production-min-32-chars"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false" # Set to true in production HTTPS
CORS_ORIGIN="http://localhost:5173"

# System Policies
AUTO_APPROVE_STUDENTS="true" # Set to false if Admin approval required before check-in
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# Admin Seed Account (Used by seed script for initial setup)
DEFAULT_ADMIN_EMAIL="admin@university.edu.kh"
DEFAULT_ADMIN_PASSWORD="Admin@ChangeMe2026!"
DEFAULT_ADMIN_NAME_KH="អ្នកគ្រប់គ្រងប្រព័ន្ធ"
DEFAULT_ADMIN_NAME_EN="System Administrator"
DEFAULT_ADMIN_STAFF_ID="ADMIN001"
